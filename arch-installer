# ── Locale & timezone ──
setup_locale() {
    info "Configuring Locale & timezone..."
    echo "en_US.UTF-8 UTF-8" > /etc/locale.gen
    echo "LANG=en_US.UTF-8" > /etc/locale.conf
    cat > /etc/vconsole.conf <<EOF
KEYMAP=fr
FONT=ter-v32n
EOF
    locale-gen
    ln -sf /usr/share/zoneinfo/Africa/Algiers /etc/localtime
    hwclock --systohc
 
    ok "Locale & timezone configured."
}

# ── Hostname ──
setup_hostname() {
    info "Configuring Hostname..."
    local hostname
    while true; do
        read -rp "Hostname: " hostname
        [[ "$hostname" =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]] && break
        warn "Invalid hostname (letters/numbers/hyphens only)."
    done
    echo "$hostname" > /etc/hostname
    cat > /etc/hosts << EOF
127.0.0.1   localhost
::1         localhost
127.0.1.1   ${hostname}.localdomain ${hostname}
EOF
 
    ok "Hostname configured."
}

# ── Sudo ──
setup_sudo() {
    info "Configuring Sudo..."
    echo "%wheel ALL=(ALL:ALL) ALL" > /etc/sudoers.d/wheel
    chmod 440 /etc/sudoers.d/wheel
 
    ok "Sudo configured."
}

# ── Services ──
enable_services() {
    info "Configuring Services..."
    systemctl enable NetworkManager
    systemctl enable fstrim.timer
    #systemctl enable systemd-oomd
    mkinitcpio -P
 
    ok "Services configured."
}

# ── GRUB ──
setup_grub() {
    info "Configuring GRUB..."
    if grep -q '^GRUB_DISABLE_OS_PROBER=' /etc/default/grub; then
        sed -i 's/^GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=false/' /etc/default/grub
    else
        echo "GRUB_DISABLE_OS_PROBER=false" >> /etc/default/grub
    fi
    grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=ArchLinux
    grub-mkconfig -o /boot/grub/grub.cfg
 
    ok "GRUB configured."
}

# ── User ──
create_user() {
    info "Adding user..."
    local fullname username
    read -rp "Enter full name : " fullname
    while true; do
        read -rp "Enter username : " username
        [[ "$username" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] && break
        warn "Invalid username (lowercase, start with letter/underscore)."
    done
    useradd -m -c "$fullname" -s /bin/bash "$username" || die "Failed to create user."
    until passwd "$username"; do warn "Try again."; done
    usermod -aG wheel,audio,video,optical,storage,network "$username"
    runuser -l "$username" -c "xdg-user-dirs-update"
    ok "User $username added."
}

# ============================================================
# System Install
# ============================================================
run_all() {
    set -euo pipefail
    set -o errtrace
    trap 'die "Chroot step failed (exit $?) at line $LINENO: ${BASH_COMMAND}"' ERR
 
    pacman_tweaks
    package_list
    select_display_server
    install_packages
    setup_zram
    #setup_oomd
    setup_hostname
    setup_locale
    setup_sudo
    enable_services
    setup_grub
    create_user
}
 
arch-chroot /mnt /bin/bash -c "
Green='$Green'
Cyan='$Cyan'
Red='$Red'
Yellow='$Yellow'
No='$No'
$(declare -f)
run_all
"
ok "Done. Run: umount -R /mnt && reboot"
