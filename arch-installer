#!/usr/bin/env bash

# ============================================================
#  Arch Linux Install - All-in-one (run from live ISO)
# ============================================================
set -euo pipefail
set -o errtrace

# ── Colors ─────────────────────────────────────────────
Green='\033[0;32m'
Cyan='\033[1;36m'
Red='\033[0;31m'
Yellow='\033[1;33m'
No='\033[0m'

# ── Helpers ─────────────────────────────────────────────
die()  { echo -e "${Red}[ERROR] $*${No}" >&2; exit 1; }
info() { echo -e "${Cyan}[*] $*${No}"; }
ok()   { echo -e "${Green}[✓] $*${No}"; }
warn() { echo -e "${Yellow}[!] $*${No}"; }
ask()  { read -rp "$1: " "$2"; }

# ── Error / cleanup traps ────────────────────────────────
on_error() {
    local exit_code=$? line=$1
    echo -e "${Red}[ERROR] Command failed (exit $exit_code) at line $line: ${BASH_COMMAND}${No}" >&2
}
trap 'on_error $LINENO' ERR

cleanup() {
    local exit_code=$?
    if [[ $exit_code -ne 0 ]]; then
        warn "Install failed - unmounting /mnt so you can retry..."
        if mountpoint -q /mnt/boot/efi 2>/dev/null; then
            umount -R /mnt/boot/efi 2>/dev/null || true
        fi
        if mountpoint -q /mnt 2>/dev/null; then
            umount -R /mnt 2>/dev/null || true
        fi
    fi
}
trap cleanup EXIT

# ============================================================
# Basic setup :
# ============================================================
clear
info "Updating keyring..."
setfont ter-v32n
pacman --noconfirm -Syy archlinux-keyring
loadkeys fr
timedatectl set-ntp true
clear

# ============================================================
# Disk & partitioning :
# ============================================================
info "==> Select a disk :"
# showing all disks 
mapfile -t disks < <(lsblk -d -p -n -o NAME,SIZE,MODEL | grep -E '^/dev/(sd|nvme|vd)')
for i in "${!disks[@]}"; do
    printf " %d) %s\n" "$((i + 1))" "${disks[i]}"
done

# output the selected disk
read -rp "Choice : " choice
[[ "$choice" =~ ^[0-9]+$ ]] || die "Invalid choice: not a number."
(( choice >= 1 && choice <= ${#disks[@]} )) || die "Invalid choice: out of range."
DISK="${disks[choice-1]%% *}"
info "Selected: $DISK"

# partitioning the disk
info "==> Launching cfdisk on $DISK"
echo "Create an EFI (512M, type EFI System), Linux root (rest, type Linux filesystem)"
read -rp "Press Enter to continue..." _
cfdisk "$DISK"
clear

# output the partitioned disk
lsblk "$DISK"

read -rp "EFI partition : " EFI_PART
read -rp "Root partition : " ROOT_PART

[[ -b "$EFI_PART" ]] || die "$EFI_PART is not a valid block device."
[[ -b "$ROOT_PART" ]] || die "$ROOT_PART is not a valid block device."

read -rp "Erase $EFI_PART and $ROOT_PART? [y/N]: " ans
[[ "$ans" =~ ^[Yy]$ ]] || die "Aborted by user."
clear


# ============================================================
# Format & mount
# ============================================================
# Format :
info "Formatting partitions..."
mkfs.fat -F32 "$EFI_PART"
mkfs.btrfs -f "$ROOT_PART"

# Mounting :
## Linux Partition 
mount "$ROOT_PART" /mnt
btrfs subvolume create /mnt/@
umount /mnt
BTRFS_OPTS="noatime,compress=zstd,space_cache=v2"
mount -o "${BTRFS_OPTS},subvol=@" "$ROOT_PART" /mnt

## EFI Partition 
mkdir -p /mnt/boot/efi
mount "$EFI_PART" /mnt/boot/efi

ok "Partitions mounted."
sleep 3
clear

# ============================================================
# Base install
# ============================================================
info "Installing base packages (this may take a while)..."
pacstrap /mnt \
    base base-devel \
    linux-zen linux-zen-headers linux-firmware \
    amd-ucode \
	vim nano

genfstab -U /mnt >> /mnt/etc/fstab
ok "Base installation done."
sleep 3
clear

# ============================================================
# Chroot configuration
# ============================================================

# ============================================================
# Installing Packages
# ============================================================
# ── Pacman Tweaks ───
pacman_tweaks() {
	info "Configuring pacman..."
	sed -i 's/^#\(Color\)/\1/'               					/etc/pacman.conf
	sed -i 's/^#\(VerbosePkgLists\)/\1/'    					/etc/pacman.conf
	sed -i 's/^#ParallelDownloads.*/ParallelDownloads = 5/' 	/etc/pacman.conf
	sed -i '/\[multilib\]/,/Include/s/^#//' 					/etc/pacman.conf
	pacman -Syyu

	ok "Pacman Tweaks Done."
}

# ── Essential packages ──
essential_packages() {
	info "Installing Essential packages..."
	pacman --noconfirm -S \
	    grub os-prober efibootmgr \
	    networkmanager network-manager-applet dhcpcd \
	    wireless_tools wpa_supplicant \
	    git ntfs-3g btrfs-progs dosfstools dialog terminus-font \
	    zram-generator

    ok "Installing Essential packages Done."
	sleep 1
	clear
}

# ── AMD graphics ──
amd_drivers() {
	info "Installing AMD graphics drivers..."
	pacman --noconfirm -S \
	    mesa vulkan-radeon vulkan-icd-loader \
	    libva-mesa-driver libva-utils \
	    mesa-utils ocl-icd

    ok "Installing AMD graphics drivers Done."
	sleep 1
	clear
}

# ── Wayland & audio base ──
wayland_packages() {
	info "Installing Wayland and audio base..."
	pacman --noconfirm -S \
	    wayland wayland-protocols wayland-utils \
	    polkit polkit-gnome \
	    pipewire pipewire-audio pipewire-alsa pipewire-pulse pipewire-jack \
	    alsa-utils wireplumber \
	    noto-fonts gvfs xdg-user-dirs \
	    pciutils usbutils

    ok "Installing Wayland and audio base Done."
	sleep 1
	clear
}

# ============================================================
# System configuration
# ============================================================
# ── ZRAM ──
setup_zram() {
	info "Configuring ZRAM..."
    cat > /etc/systemd/zram-generator.conf << 'EOF'
[zram0]
zram-size = 16384
compression-algorithm = zstd
swap-priority = 100
fs-type = swap
EOF

ok "ZRAM configured."
}

# ── Sysctl tuning for zram ──
setup_sysctl_zram() {
	info "Configuring sysctl for zram..."
    cat > /etc/sysctl.d/99-vm-zram-parameters.conf << 'EOF'
vm.swappiness = 180
vm.watermark_boost_factor = 0
vm.watermark_scale_factor = 125
vm.page-cluster = 0
EOF
 
ok "Sysctl for zram configured."
}

# ── Systemd-oomd ──
setup_oomd() {
	info "Configuring OOMD..."
    mkdir -p /etc/systemd/oomd.conf.d
    cat > /etc/systemd/oomd.conf.d/oomd.conf << 'EOF'
[OOM]
DefaultMemoryPressureLimit=60%
DefaultMemoryPressureDurationSec=20s
EOF

ok "OOMD configured."
}

# ── Locale & timezone ──
setup_locale() {
	info "Configuring Locale & timezone..."
    echo "en_US.UTF-8 UTF-8" > /etc/locale.gen
    echo "LANG=en_US.UTF-8" > /etc/locale.conf
	cat > /etc/vconsole.conf <<EOF
KEYMAP=fr
FONT=ter-v32n
EOF
    locale-gen
    ln -sf /usr/share/zoneinfo/Africa/Algiers /etc/localtime
    hwclock --systohc

    ok "Locale & timezone configured."
}

# ── Hostname ──
setup_hostname() {
	info  "Configuring Hostname..."
	read -rp "Hostname: " hostname
    echo "$hostname" > /etc/hostname
    cat > /etc/hosts << EOF
127.0.0.1   localhost
::1         localhost
127.0.1.1   ${hostname}.localdomain ${hostname}
EOF

ok "Hostname configured."
}

# ── Sudo ──
setup_sudo() {
	info  "Configuring Sudo..."
    echo "%wheel ALL=(ALL:ALL) ALL" > /etc/sudoers.d/wheel
    chmod 440 /etc/sudoers.d/wheel

    ok "Sudo configured."
}

# ── Services ──
enable_services() {
	info  "Configuring Services..."
    systemctl enable NetworkManager  
    systemctl enable fstrim.timer
    systemctl enable systemd-oomd
    mkinitcpio -P

    ok "Services configured."
}

# ── GRUB ──
setup_grub() {
	info  "Configuring GRUB..."
    echo "GRUB_DISABLE_OS_PROBER=false" >> /etc/default/grub
    grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=ArchLinux
    grub-mkconfig -o /boot/grub/grub.cfg

    ok "GRUB configured."
}

# ── User ──
create_user() {
	info  "Adding User..."
    ask "Enter full name" fullname
    ask "Enter username"  username
    useradd -m -c "$fullname" -s /bin/bash "$username" || die "Failed to create user."
    info "Set password for $username:"
    until passwd "$username"; do warn "Try again."; done
    usermod -aG wheel,audio,video,optical,storage,network "$username"
    runuser -l "$username" -c "xdg-user-dirs-update"

    ok "User ─ $username ─ Added "
}

# ============================================================
# System Install
# ============================================================
# ── Install ──
run_all() {
    set -euo pipefail
    set -o errtrace
	trap 'die "Chroot step failed (exit $?) at line $LINENO: ${BASH_COMMAND}"' ERR
    pacman_tweaks
    essential_packages
    amd_drivers
    wayland_packages
    setup_zram
    setup_sysctl_zram
    setup_oomd
    setup_hostname
    setup_locale
    setup_sudo
    enable_services
    setup_grub
    create_user
}

arch-chroot /mnt /bin/bash -c "
Green='$Green'
Cyan='$Cyan'
Red='$Red'
Yellow='$Yellow'
No='$No'
$(declare -f)
run_all
"
ok "Done. Run: umount -R /mnt && reboot"
