#!/usr/bin/env bash

# ============================================================
#  Arch Linux Install - All-in-one (run from live ISO)
# ============================================================
set -euo pipefail
set -o errtrace

# ── Colors ─────────────────────────────────────────────
Green='\033[0;32m'
Cyan='\033[1;36m'
Red='\033[0;31m'
Yellow='\033[1;33m'
No='\033[0m'
 
# ── Helpers ─────────────────────────────────────────────
die()  { echo -e "${Red}[ERROR] $*${No}" >&2; exit 1; }
info() { echo -e "${Cyan}[*] $*${No}"; }
ok()   { echo -e "${Green}[✓] $*${No}"; }
warn() { echo -e "${Yellow}[!] $*${No}"; }

retry() {
    local n=1
    until "$@"; do
        (( n++ >= 3 )) && die "Failed after 3 attempts: $*"
        warn "Retrying ($n/3): $*"; sleep 5
    done
}
# ── Error ── 
on_error() { echo -e "${Red}[ERROR] Command failed (exit $?) at line $1: ${BASH_COMMAND}${No}" >&2; }
trap 'on_error $LINENO' ERR
# ── Cleanup ──
cleanup() {
    (( $? != 0 )) || return 0
    warn "Install failed - unmounting /mnt so you can retry..."
    mountpoint -q /mnt/boot/efi 2>/dev/null && umount -R /mnt/boot/efi 2>/dev/null
    mountpoint -q /mnt 2>/dev/null && umount -R /mnt 2>/dev/null
    true
}
trap cleanup EXIT

# ============================================================
# Basic setup :
# ============================================================
clear
info "Updating keyring..."
setfont ter-v32n
pacman --noconfirm -Syy archlinux-keyring
loadkeys fr
timedatectl set-ntp true

# ── Mirror optimization ──
if command -v reflector &>/dev/null; then
    info "Ranking mirrors by speed..."
    reflector --latest 15 --age 12 --protocol https --sort rate --save /etc/pacman.d/mirrorlist || warn "reflector failed, using existing mirrorlist"
fi
clear

# ============================================================
# Disk & partitioning :
# ============================================================
info "==> Select a disk :"
# showing all disks 
mapfile -t disks < <(lsblk -d -p -n -o NAME,SIZE,MODEL | grep -E '^/dev/(sd|nvme|vd)')
for i in "${!disks[@]}"; do
    printf " %d) %s\n" "$((i + 1))" "${disks[i]}"
done

# output the selected disk
read -rp "Choice : " choice
[[ "$choice" =~ ^[0-9]+$ ]] || die "Invalid choice: not a number."
(( choice >= 1 && choice <= ${#disks[@]} )) || die "Invalid choice: out of range."
DISK="${disks[choice-1]%% *}"
info "Selected: $DISK"

# partitioning the disk
info "==> Launching cfdisk on $DISK"
echo "Create an EFI (512M, type EFI System), Linux root (rest, type Linux filesystem)"
read -rp "Press Enter to continue..." _
cfdisk "$DISK"
clear

# output the partitioned disk
lsblk "$DISK"

read -rp "EFI partition : " EFI_PART
read -rp "Linux partition : " LINUX_PART

[[ -b "$EFI_PART" ]] || die "$EFI_PART is not a valid block device."
[[ -b "$LINUX_PART" ]] || die "$LINUX_PART is not a valid block device."

read -rp "Erase $EFI_PART and $LINUX_PART? [y/N]: " ans
[[ "$ans" =~ ^[Yy]$ ]] || die "Aborted by user."
clear


# ============================================================
# Format & mount
# ============================================================
# Format :
info "Formatting partitions..."
mkfs.fat -F32 "$EFI_PART"
mkfs.btrfs -f "$LINUX_PART"

# Mounting :
## Linux Partition 
mount "$LINUX_PART" /mnt
btrfs subvolume create /mnt/@
umount /mnt
BTRFS_OPTS="noatime,compress=zstd,space_cache=v2"
mount -o "${BTRFS_OPTS},subvol=@" "$LINUX_PART" /mnt

## EFI Partition 
mkdir -p /mnt/boot/efi
mount "$EFI_PART" /mnt/boot/efi

ok "Partitions mounted."
sleep 3
clear

# ============================================================
# Base install
# ============================================================
info "Installing base packages (this may take a while)..."
pacstrap /mnt \
    base base-devel \
    linux-zen linux-zen-headers linux-firmware \
    amd-ucode \
    vim nano

genfstab -U /mnt >> /mnt/etc/fstab
ok "Base installation done."
sleep 3
clear

# ============================================================
# Chroot configuration
# ============================================================
# ── Pacman Tweaks ───
pacman_tweaks() {
    info "Configuring pacman..."
    sed -i 's/^#\(Color\)/\1/'                                  /etc/pacman.conf
    sed -i 's/^#\(VerbosePkgLists\)/\1/'                        /etc/pacman.conf
    sed -i 's/^#ParallelDownloads.*/ParallelDownloads = 5/'     /etc/pacman.conf
    sed -i '/\[multilib\]/,/Include/s/^#//'                     /etc/pacman.conf
    pacman -Syyu

    ok "Pacman Tweaks Done."
}

# ── Package lists ──
package_list() {
    essential_packages=(
        grub os-prober efibootmgr
        networkmanager network-manager-applet wpa_supplicant
        git ntfs-3g btrfs-progs dosfstools dialog terminus-font
        zram-generator
    )

    amd_drivers=(
        mesa vulkan-radeon vulkan-icd-loader
        libva-mesa-driver libva-utils
        mesa-utils ocl-icd
    )

    audio_pkgs=(
        pipewire pipewire-audio pipewire-alsa pipewire-pulse pipewire-jack
        alsa-utils wireplumber
    )

    common_pkgs=(
        polkit polkit-gnome
        noto-fonts gvfs xdg-user-dirs
        pciutils usbutils
    )

    wayland_pkgs=(
        wayland wayland-protocols wayland-utils
    )

    x11_pkgs=(
        xorg-server xorg-xinit xorg-xkill xorg-xsetroot xorg-xprop xorg-xinput
    )

    PKGS=("${essential_packages[@]}" "${amd_drivers[@]}" "${common_pkgs[@]}" "${audio_pkgs[@]}")
}

# ── Display Server ──
select_display_server() {
    info "Select your display server:  1) Wayland   2) X11"
    while true; do
        read -rp "Choice [1-2]: " c
        case "$c" in
            1) PKGS+=("${wayland_pkgs[@]}"); break ;;
            2) PKGS+=("${x11_pkgs[@]}");     break ;;
            *) warn "Invalid choice." ;;
        esac
    done
}

# ============================================================
# Installing Packages
# ============================================================
install_packages() {
    info "Installing ${#PKGS[@]} packages in a single transaction..."
    retry pacman --noconfirm -S "${PKGS[@]}"
    ok "Package installation done."
}

# ============================================================
# System configuration
# ============================================================
# ── ZRAM ──
setup_zram() {
    info "Configuring ZRAM..."
    cat > /etc/systemd/zram-generator.conf << 'EOF'
[zram0]
zram-size = 16384
compression-algorithm = zstd
swap-priority = 100
fs-type = swap
EOF

    ok "ZRAM configured."
}

# ── Sysctl tuning for zram ──
setup_sysctl_zram() {
    info "Configuring sysctl for zram..."
    cat > /etc/sysctl.d/99-vm-zram-parameters.conf << 'EOF'
vm.swappiness = 180
vm.watermark_boost_factor = 0
vm.watermark_scale_factor = 125
vm.page-cluster = 0
EOF
 
    ok "Sysctl for zram configured."
}

